// The website as Cloudflare Workers static assets: no Worker code, only the files in
// dist/. Build with this domain as --base first; README.md has the steps.
{
  "name": "amdl-site",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "amdl.lyjw.me", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
