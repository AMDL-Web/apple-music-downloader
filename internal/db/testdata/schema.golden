  column id INTEGER notnull=0 default=NULL pk=1
  column job_id TEXT notnull=1 default=NULL pk=0
  column item_id TEXT notnull=1 default='' pk=0
  column type TEXT notnull=1 default=NULL pk=0
  column phase TEXT notnull=1 default='' pk=0
  column message TEXT notnull=1 default='' pk=0
  column payload TEXT notnull=1 default='' pk=0
  column created_at TEXT notnull=1 default=NULL pk=0
table run_items
  column id TEXT notnull=0 default=NULL pk=1
  column job_id TEXT notnull=1 default=NULL pk=0
  column adam_id TEXT notnull=1 default=NULL pk=0
  column kind TEXT notnull=1 default=NULL pk=0
  column idx INTEGER notnull=1 default=NULL pk=0
  column title TEXT notnull=1 default='' pk=0
  column artist TEXT notnull=1 default='' pk=0
  column album TEXT notnull=1 default='' pk=0
  column duration_ms INTEGER notnull=1 default=0 pk=0
  column artwork_url TEXT notnull=1 default='' pk=0
  column has_lyrics INTEGER notnull=1 default=0 pk=0
  column lyrics_status TEXT notnull=1 default='' pk=0
  column status TEXT notnull=1 default=NULL pk=0
  column download_progress REAL notnull=1 default=0 pk=0
  column decrypt_progress REAL notnull=1 default=0 pk=0
  column download_bytes INTEGER notnull=1 default=0 pk=0
  column progress_resolved INTEGER notnull=1 default=0 pk=0
  column progress_remuxed INTEGER notnull=1 default=0 pk=0
  column progress_verified INTEGER notnull=1 default=0 pk=0
  column progress_tagged INTEGER notnull=1 default=0 pk=0
  column progress_saved INTEGER notnull=1 default=0 pk=0
  column codec TEXT notnull=1 default='' pk=0
  column bit_depth INTEGER notnull=1 default=0 pk=0
  column sample_rate INTEGER notnull=1 default=0 pk=0
  column bitrate INTEGER notnull=1 default=0 pk=0
  column file_size INTEGER notnull=1 default=0 pk=0
  column retry_kind TEXT notnull=1 default='' pk=0
  column attempt INTEGER notnull=1 default=0 pk=0
  column max_attempts INTEGER notnull=1 default=0 pk=0
  column status_message TEXT notnull=1 default='' pk=0
  column output_path TEXT notnull=1 default='' pk=0
  column error TEXT notnull=1 default='' pk=0
  column slot TEXT notnull=1 default='main' pk=0
  column owner_kind TEXT notnull=1 default='' pk=0
  column owner_id TEXT notnull=1 default='' pk=0
  column created_at TEXT notnull=1 default=NULL pk=0
  column updated_at TEXT notnull=1 default=NULL pk=0
  constraint pk(id)
  foreign key job_id -> runs(id) on update NO ACTION on delete NO ACTION
table runs
  column id TEXT notnull=0 default=NULL pk=1
  column input TEXT notnull=1 default=NULL pk=0
  column type TEXT notnull=1 default=NULL pk=0
