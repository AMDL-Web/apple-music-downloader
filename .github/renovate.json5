{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':gitSignOff',
  ],
  baseBranchPatterns: [
    'dev',
  ],
  timezone: 'Asia/Shanghai',
  schedule: [
    '* 9 * * 1',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  configMigration: true,
  minimumReleaseAge: '3 days',
  prConcurrentLimit: 5,
  labels: [
    'dependencies',
  ],
  postUpdateOptions: [
    'gomodTidy',
  ],
  packageRules: [
    {
      description: "Dependency upgrades are not bug fixes: turn config:recommended's default fix(deps) back into chore(deps)",
      matchManagers: [
        'gomod',
        'dockerfile',
        'docker-compose',
      ],
      semanticCommitType: 'chore',
    },
    {
      description: 'Go dependencies: minor, patch and pseudo-version digest updates share one PR; major versions get their own PR so breaking changes are assessed one by one',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'go dependencies',
    },
    {
      description: 'Temari, the upstream of internal/fairplay, gets a PR of its own so the Temari parity CI job judges that one upgrade: green means upstream changed speed or packaging only, red means internal/fairplay needs re-translating (tools/temaridiff/doc.go)',
      matchPackageNames: [
        'github.com/WorldObservationLog/Temari/bindings/go',
      ],
      groupName: 'temari',
    },
    {
      description: 'Container base images: golang and alpine in the Dockerfile',
      matchManagers: [
        'dockerfile',
        'docker-compose',
      ],
      groupName: 'docker base images',
    },
    {
      description: 'Actions are mostly tagged by major version only (v6 → v7), so splitting by update type achieves nothing; group them all into one PR',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
      semanticCommitType: 'ci',
      labels: [
        'github-actions',
      ],
    },
    {
      description: "This repository's own published image, pushed by docker-publish.yml; not an external dependency",
      matchPackageNames: [
        'ghcr.io/amdl-web/apple-music-downloader',
      ],
      enabled: false,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
  },
}
